{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ios-sidestore-deploy/build-manifest.schema.json",
  "title": "Unsigned iOS build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "commitSha",
    "workflowRunId",
    "xcodeVersion",
    "runnerImage",
    "foundationRepository",
    "foundationRef",
    "scheme",
    "configuration",
    "bundleIdentifier",
    "appVersion",
    "buildNumber",
    "minimumOSVersion",
    "ipaFileName",
    "ipaSha256",
    "signed",
    "buildTimestampUtc"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "workflowRunId": { "type": "string", "minLength": 1 },
    "xcodeVersion": { "type": "string", "minLength": 1 },
    "runnerImage": { "type": "string", "minLength": 1 },
    "foundationRepository": { "type": "string", "minLength": 1 },
    "foundationRef": { "type": "string", "minLength": 1 },
    "scheme": { "type": "string", "minLength": 1 },
    "configuration": { "type": "string", "minLength": 1 },
    "bundleIdentifier": { "type": "string", "minLength": 1 },
    "appVersion": { "type": "string", "minLength": 1 },
    "buildNumber": { "type": "string", "minLength": 1 },
    "minimumOSVersion": { "type": "string", "minLength": 1 },
    "ipaFileName": { "type": "string", "pattern": "^[^/\\\\]+\\.ipa$" },
    "ipaSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "signed": { "const": false },
    "buildTimestampUtc": { "type": "string", "format": "date-time" }
  }
}
